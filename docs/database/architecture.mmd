flowchart TB
  subgraph APP[Application]
    direction TB

    subgraph UI[Frontend (Vite + React)]
      UI_Pages["Pages\n- Login/Signup\n- Dashboard\n- Companies / Suppliers\n- Pricing / Inventory\n- AI Chat"]
      UI_Client["HTTP API client\nFrontend/src/lib/api.ts"]
      UI_Pages --> UI_Client
    end

    subgraph API[Backend (FastAPI)]
      API_Routers["Routers\n/api/auth\n/api/companies\n/api/suppliers\n/api/admin\n/api/ai"]
      API_Services["Service layer\nauth, profiles, pricing, inventory, requests, ai"]
      API_Repos["Repository layer\nSQL queries + transactions"]
      API_Routers --> API_Services --> API_Repos
    end

    UI_Client --> API_Routers
  end

  DB[(PostgreSQL)]
  API_Repos --> DB

  subgraph DBS[DB Schemas / Tables]
    direction TB

    subgraph AUTH[auth]
      U["auth.users\nPK user_id (uuid)\nemail UNIQUE\npassword_hash\nrole, status"]
    end

    subgraph PROFILES[profiles]
      C["profiles.clients\nPK client_id\nFK user_id UNIQUE\nprofile_json (jsonb)\npreferences (jsonb)"]
      CO["profiles.companies\nPK company_id\nFK user_id UNIQUE\nslug UNIQUE\ncompany_name\nprofile_json (jsonb)"]
      COP["profiles.company_pricing\nPK/FK company_id\noperational_areas (jsonb)\nflattened_operational_areas (jsonb)\npackage_scope (jsonb)"]
      SU["profiles.suppliers\nPK supplier_id\nFK user_id UNIQUE\nslug UNIQUE\nsupplier_name\nprofile_json (jsonb)"]
      SUI["profiles.supplier_inventory\nPK/FK supplier_id\nmaterials (jsonb)\navailability (jsonb)"]
      AD["profiles.admins\nPK admin_id\nFK user_id UNIQUE\npermissions (jsonb)"]
    end

    subgraph ADMIN[admin]
      PS["admin.platform_settings\n(single row)\nsettings (jsonb)"]
      AL["admin.activity_log\nPK activity_id\naction / target / details\nmeta (jsonb)\nactor_user_id FK"]
    end

    subgraph MKT[marketplace]
      QR["marketplace.quote_requests\nPK request_id\nFK client_id\nFK company_id (optional)\nstatus\nrequirements (jsonb)\nbudget (jsonb)"]
    end

    subgraph AI[ai]
      CS["ai.chat_sessions\nPK session_id\nFK user_id"]
      CM["ai.chat_messages\nPK message_id\nFK session_id\nrole + content\nmeta (jsonb)"]
      RD["ai.rag_documents (optional)\nPK document_id\ndoc_json (jsonb)"]
      RC["ai.rag_chunks (optional)\nPK chunk_id\nFK document_id\ncontent + meta"]
    end
  end

  DB --- DBS
  U -->|"role=client\n1 : 0..1"| C
  U -->|"role=company\n1 : 0..1"| CO
  U -->|"role=supplier\n1 : 0..1"| SU
  U -->|"role=admin\n1 : 0..1"| AD

  CO -->|"1 : 1"| COP
  SU -->|"1 : 1"| SUI

  C -->|"1 : N"| QR
  CO -->|"0..1 : N (assigned)"| QR

  U -->|"0..1 : N (actor_user_id)"| AL

  U -->|"0..1 : N"| CS
  CS -->|"1 : N"| CM

  RD -->|"1 : N"| RC
