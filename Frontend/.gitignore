# ══════════════════════════════════════════════════════════════
# Smart Construction Connect — FRONTEND .gitignore
# ══════════════════════════════════════════════════════════════

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.npm
.eslintcache

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ── Environment & Secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Vercel ───────────────────────────────────────────────────
.vercel

# ── Testing ──────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
playwright/.cache/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
[Dd]esktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
