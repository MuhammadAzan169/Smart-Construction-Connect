# ══════════════════════════════════════════════════════════════
# Smart Construction Connect — repository-wide ignores
# (Backend/.gitignore and Frontend/.gitignore add per-part rules)
# ══════════════════════════════════════════════════════════════

# ── Environment & secrets — never commit these ───────────────
.env
.env.*
!.env.example
*.local
secrets.json
*.pem
*.key

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node ─────────────────────────────────────────────────────
node_modules/
dist/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── OS / editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
[Dd]esktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ── Personal / non-project notes (kept locally, not published) ─
CV_PROJECT_DESCRIPTION.md
