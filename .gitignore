coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ── CI/CD ────────────────────────────────────────────────────
.github/workflows/*.log
.gitlab-ci.yml
.circleci/

# ── Documentation ────────────────────────────────────────────
docs/_build/
*.pdf
*.docx

# ── Miscellaneous ────────────────────────────────────────────
# Local Netlify folder
.netlify

# Vercel
.vercel

# Sentry Config File
.sentryclirc

# ── Project Specific ─────────────────────────────────────────
# Uploaded files during development
uploads/
temp/
cache/

# API keys and secrets (double-check)
secrets.json
config.local.json

# Development databases
*.db
*.sqlite
*.sqlite3

# ── Keep These Empty Directories ─────────────────────────────
!.gitkeep
!.gitignore
