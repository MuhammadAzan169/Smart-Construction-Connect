.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/
public

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# ── Database & User Data ─────────────────────────────────────
# User-generated content (NEVER commit)
Database/clients/
Database/construction/
Database/suppliers/
Database/messages/
Database/admin/event_log.json
Database/admin/activity_log.json

# Keep demo data structure but not actual user data
!Database/admin/
!Database/admin/.gitkeep

# Company data uploads
company_data/
!company_data/.gitkeep

