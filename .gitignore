node_modules/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Build Output ─────────────────────────────────────────────
dist/
dist-ssr/
build/
Frontend/dist/
backend/dist/
*.tsbuildinfo

