# ══════════════════════════════════════════════════════════════
# Smart Construction Connect — repository-wide ignores
# (backend/.gitignore and frontend/.gitignore add per-part rules)
# ══════════════════════════════════════════════════════════════

# ── Environment & secrets — never commit these ───────────────
.env
.env.*
!.env.example
*.local
secrets.json
*.pem
*.key

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node ─────────────────────────────────────────────────────
node_modules/
dist/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── OS / editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
[Dd]esktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ── Personal / non-project notes (kept locally, not published) ─
CV_PROJECT_DESCRIPTION.md

# -- Local runner artefacts (created by `python app.py`) -------
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -- Local model caches (downloaded by sentence-transformers/easyocr) --
.cache/
**/.cache/huggingface/

# -- Vercel --------------------------------------------------
.vercel
