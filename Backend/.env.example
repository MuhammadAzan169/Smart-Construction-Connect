# =============================================================================
# Smart Construction Connect — BACKEND environment variables
# Copy this file to `.env` and fill in your values (local dev).
# On Render, set these in the service's "Environment" tab instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Application environment
# Set to "production" on Render. This enforces a strong JWT_SECRET_KEY.
# -----------------------------------------------------------------------------
ENV=development

# -----------------------------------------------------------------------------
# Server port
# Local dev: defaults to 8000. On Render, DO NOT set this — Render injects $PORT
# automatically and the app reads it.
# -----------------------------------------------------------------------------
PORT=8000

# -----------------------------------------------------------------------------
# Security / JWT
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED to be changed when ENV=production.
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# CORS — allowed browser origins for the API.
# Add your deployed Vercel URL here once you have it, e.g.:
#   CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:8080
# (Not strictly required if the frontend proxies the API via vercel.json
#  rewrites, but recommended if the browser ever calls the API directly.)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# OpenRouter (AI chat). Get keys at https://openrouter.ai — free tier available.
# Every variable starting with OPENROUTER_API_KEY is auto-discovered and
# rotated for rate-limit resilience. Add as many as you like (1..29).
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY1=sk-or-v1-your-api-key-here
# OPENROUTER_API_KEY2=
# OPENROUTER_API_KEY3=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ordered model chain — rotated through on errors / rate limits.
OPENROUTER_MODEL_1=openai/gpt-oss-120b:free
OPENROUTER_MODEL_2=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_3=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MODEL_4=openai/gpt-oss-20b:free
OPENROUTER_MODEL_5=stepfun/step-3.5-flash:free

# -----------------------------------------------------------------------------
# Supabase — Postgres document store (durable data). REQUIRED in production.
# Copy the "Transaction pooler" connection string from Supabase:
#   Project → Settings → Database → Connection string → "Transaction pooler"
# (host looks like aws-0-xxx.pooler.supabase.com, port 6543). Put your DB
# password in it. Leave DATABASE_URL empty to use local JSON files (dev only).
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase Storage — binary uploads (profile images, documents, attachments).
# SUPABASE_URL:  Project → Settings → API → Project URL (https://xxxx.supabase.co)
# SERVICE ROLE:  Project → Settings → API Keys → "Legacy anon, service_role API
#                keys" tab → service_role key (a JWT starting with "eyJ...").
#                IMPORTANT: use the LEGACY key, not the new sb_secret_... key —
#                Supabase Storage's REST API requires a JWT bearer token and
#                rejects the new opaque secret-key format ("Invalid Compact JWS").
# Create a PUBLIC storage bucket named to match SUPABASE_BUCKET (default: media).
# Leave these empty to store uploads on local disk (dev only).
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# -----------------------------------------------------------------------------
# Semantic search embeddings — OpenAI-compatible API (keeps RAM low on free tier).
# Leave blank to fall back to BM25 keyword search (no external calls, weaker match).
#
# Recommended (cheapest that still handles English + Urdu + Roman Urdu well):
# Cohere's "light" multilingual model — get a free key at https://dashboard.cohere.com
#   EMBEDDINGS_API_URL   https://api.cohere.ai/compatibility/v1
#   EMBEDDINGS_API_KEY   your Cohere key
#   EMBEDDINGS_MODEL     embed-multilingual-light-v3.0   (384-dim: cheap, low RAM)
#     — use embed-multilingual-v3.0 (1024-dim) instead for higher search quality
#       at higher cost/RAM.
# Any OpenAI-compatible embeddings endpoint works the same way, e.g.:
#   EMBEDDINGS_API_URL=https://api.openai.com/v1, EMBEDDINGS_MODEL=text-embedding-3-small
#
# ENABLE_LOCAL_SBERT=1 only on a host with >=2GB RAM (uses local PyTorch instead).
# -----------------------------------------------------------------------------
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
ENABLE_LOCAL_SBERT=0

# -----------------------------------------------------------------------------
# File upload limits (bytes)
# -----------------------------------------------------------------------------
MAX_IMAGE_SIZE=5242880     # 5 MB
MAX_DOC_SIZE=10485760      # 10 MB

# -----------------------------------------------------------------------------
# Data directories (optional — default to the backend repo root)
# -----------------------------------------------------------------------------
# DATA_DIR=./Database
# COMPANY_DATA_DIR=./company_data

# -----------------------------------------------------------------------------
# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
