# =============================================================================
# Smart Construction Connect -- Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================


# -----------------------------------------------------------------------------
# AI / LLM  (Required for AI Chat)
# Get your keys from https://openrouter.ai -- free tier available
# -----------------------------------------------------------------------------

OPENROUTER_API_KEY_1=sk-or-v1-your-api-key-here

# Add up to 28 keys for round-robin load balancing and rate-limit resilience.
# Uncomment and fill in additional keys as needed.
# OPENROUTER_API_KEY_2=sk-or-v1-second-key
# OPENROUTER_API_KEY_3=sk-or-v1-third-key
# OPENROUTER_API_KEY_4=sk-or-v1-fourth-key
# OPENROUTER_API_KEY_5=sk-or-v1-fifth-key
# ...
# OPENROUTER_API_KEY_28=sk-or-v1-28th-key

# LLM models to rotate through on errors / rate limits (up to 5).
# Defaults are used when these are not set.
OPENROUTER_MODEL_1=microsoft/wizardlm-2-8x22b
OPENROUTER_MODEL_2=meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL_3=anthropic/claude-3-haiku
# OPENROUTER_MODEL_4=google/gemma-2-9b-it
# OPENROUTER_MODEL_5=mistralai/mistral-7b-instruct


# -----------------------------------------------------------------------------
# Security
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED to be set in production (ENV=production enforces this).
# -----------------------------------------------------------------------------

JWT_SECRET_KEY=scc-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# -----------------------------------------------------------------------------
# Application Environment
# Set to "production" to enable stricter checks (forces JWT_SECRET_KEY change).
# -----------------------------------------------------------------------------

ENV=development


# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins for the API.
# In development, the Vite proxy handles cross-origin requests automatically.
# -----------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# Data Directories (optional -- defaults to repo root)
# Override if you want to store data outside the project folder.
# -----------------------------------------------------------------------------

# DATA_DIR=./Database
# COMPANY_DATA_DIR=./company_data


# -----------------------------------------------------------------------------
# File Upload Limits (optional -- defaults shown in bytes)
# -----------------------------------------------------------------------------

# MAX_IMAGE_SIZE=5242880    # 5 MB
# MAX_DOC_SIZE=10485760     # 10 MB


# -----------------------------------------------------------------------------
# Logging
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
