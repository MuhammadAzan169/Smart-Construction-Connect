{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://smart-contruction-connect-backend.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://smart-contruction-connect-backend.onrender.com/uploads/$1"
    },
    {
      "source": "/company_data/(.*)",
      "destination": "https://smart-contruction-connect-backend.onrender.com/company_data/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
